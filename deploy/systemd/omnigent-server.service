# Omnigent server (API, routes, agent bundles), run from the friendly-layer
# worktree. Installed by deploy/systemd/install.sh.
[Unit]
Description=Omnigent server (friendly-layer)
After=network-online.target

[Service]
WorkingDirectory=/home/nexus/wt/friendly-layer
Environment=HOME=/home/nexus
Environment=LANG=en_US.UTF-8
Environment=PATH=/home/nexus/.local/bin:/home/nexus/.pixi/bin:/home/nexus/.kimi-code/bin:/home/nexus/.opencode/bin:/home/nexus/.nvm/versions/node/v22.19.0/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:/snap/bin
Environment=OMNIGENT_SPOKEN_SUMMARY_ENABLED=true
Environment=OMNIGENT_SPOKEN_SUMMARY_LANGUAGE=pt-BR
Environment=OMNIGENT_DICTATION_ENGINE=whisper
Environment=OMNIGENT_DICTATION_PREFER_SERVER=1
Environment=OMNIGENT_DICTATION_WHISPER_LANGUAGE=en
ExecStart=/home/nexus/wt/friendly-layer/.venv/bin/omni server --host 0.0.0.0 --port 6767 --agent /home/nexus/omnigent-fork/examples/debby --agent /home/nexus/wt/friendly-layer/examples/nexus
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
