# Omnigent host: owns the runner zygote that forks every session's runner
# (harnesses, native bridges, readers). It must import the SAME checkout as the
# server. Run from omnigent-fork it silently ran that tree's code instead, so
# runner-side fixes made here never executed. Installed by install.sh.
[Unit]
Description=Omnigent host (friendly-layer)
After=omnigent-server.service
Wants=omnigent-server.service

[Service]
WorkingDirectory=/home/nexus/wt/friendly-layer
Environment=HOME=/home/nexus
Environment=PATH=/home/nexus/.local/bin:/home/nexus/.pixi/bin:/home/nexus/.kimi-code/bin:/home/nexus/.opencode/bin:/home/nexus/.nvm/versions/node/v22.19.0/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:/snap/bin
ExecStart=/home/nexus/wt/friendly-layer/.venv/bin/omni host --server http://127.0.0.1:6767
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
