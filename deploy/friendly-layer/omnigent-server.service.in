# Omnigent server (API, routes, agent bundles), run from the friendly-layer
# worktree. Installed by deploy/systemd/install.sh.
[Unit]
Description=Omnigent server (friendly-layer)
After=network-online.target

[Service]
WorkingDirectory=@CHECKOUT@
Environment=HOME=@HOME@
Environment=LANG=en_US.UTF-8
Environment=PATH=@PATH@
Environment=OMNIGENT_SPOKEN_SUMMARY_ENABLED=true
Environment=OMNIGENT_SPOKEN_SUMMARY_LANGUAGE=pt-BR
Environment=OMNIGENT_DICTATION_ENGINE=whisper
Environment=OMNIGENT_DICTATION_PREFER_SERVER=1
Environment=OMNIGENT_DICTATION_WHISPER_LANGUAGE=en
# Release features this host serves. usage_page turns on the Usage screen
# (per-provider tokens and plan-limit history); without it the route and the
# sidebar entry stay hidden.
Environment=OMNIGENT_FEATURES=usage_page
ExecStart=@CHECKOUT@/.venv/bin/omni server --host 0.0.0.0 --port 6767 --agent @CHECKOUT@/examples/debby --agent @CHECKOUT@/examples/nexus
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
